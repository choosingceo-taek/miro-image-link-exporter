{
  "manifest_version": 3,
  "name": "RACK 상품 수집기",
  "version": "1.4.0",
  "description": "서버가 못 긁는 봇 차단 쇼핑몰을 실제 크롬 탭으로 방문·수집해 RACK 공유 저장소(미로 앱)로 전송합니다. 매일 자동 수집 예약 지원.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RACK 상품 수집기"
  }
}
